{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": false,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["../retest.config.ts", "**/*"]
}
